{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "moduleResolution": "bundler",
    "outDir": "web-dist/app",
    "rootDir": "src/web",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.js"],
  "exclude": ["src/web/**/*.svelte.ts", "src/web/**/*.svelte", "src/web/lib/**", "src/web/stores/**", "src/web/svelte-main.ts", "src/web/App.svelte"]
}