{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@opencorp/sdk": ["./src/sdk/index.ts"],
      "@/*": ["./src/web/*"]
    }
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx", "src/web/**/*.js", "src/web/**/*.jsx"],
  "exclude": [
    "src/web/**/*.svelte.ts",
    "src/web/**/*.svelte",
    "src/web/views/**/*",
    "src/web/views/*",
    "src/web/components/**/*",
    "src/web/components/*",
    "src/web/ui/**/*",
    "src/web/ui/*",
    "src/web/lib/chat/sessions-store.ts",
    "src/web/lib/chat/store.tsx",
    "src/web/lib/chat/stream-handler.ts"
  ]
}