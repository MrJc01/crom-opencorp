{
  "level": "standard",
  "blocklist": ["rm -rf", "shutdown", "reboot", "curl * | bash", "git push --force"],
  "allowlist_extra": ["node", "npm", "python3"],
  "network_allowlist": ["registry.npmjs.org", "github.com", "pypi.org"],
  "hitl_patterns": ["git push", "npm publish", "DROP ", "DELETE FROM"]
}
