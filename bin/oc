#!/usr/bin/env node
/**
 * oc — CLI de alta velocidade do OpenCorp
 * Wrapper ergonômico com detecção automática do workspace pelo diretório atual (cwd)
 */
import { spawn } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { existsSync, readFileSync } from "node:fs";

const aqui = dirname(fileURLToPath(import.meta.url));
const opencorpBin = join(aqui, "opencorp.mjs");

const args = process.argv.slice(2);

// Atalho rápido: oc doc ajuda [slug]
if (args[0] === "doc" && args[1] === "ajuda") {
  const slug = args[2] || "estudo-padronizacao";
  try {
    const res = await fetch(`http://127.0.0.1:4100/docs/${slug}`);
    if (res.ok) {
      const data = await res.json();
      console.log(`\n=== ${data.titulo} (${data.categoria}) ===\n`);
      console.log(data.conteudo);
      process.exit(0);
    }
  } catch {
    console.error(`erro: não foi possível conectar na API do OpenCorp em http://127.0.0.1:4100/docs/${slug}`);
  }
}

// Se não foi passada a flag --workspace, tenta inferir com máxima precisão
const temWsFlag = args.includes("--workspace") || args.includes("-w");
let extraArgs = [];

function resolverWorkspace(): string | null {
  // 1. Variável de ambiente explícita injetada pelo OpenCorp no runner
  if (process.env.OPENCORP_WORKSPACE && process.env.OPENCORP_WORKSPACE.trim()) {
    return process.env.OPENCORP_WORKSPACE.trim();
  }

  // 2. Busca recursiva ascendente a partir do diretório atual procurando .opencorp
  try {
    let dir = process.cwd();
    while (dir && dir !== "/") {
      if (existsSync(join(dir, ".opencorp"))) {
        const candidatoId = dir.split("/").pop();
        if (candidatoId && candidatoId !== ".opencorp") {
          return candidatoId;
        }
      }
      const pai = dirname(dir);
      if (pai === dir) break;
      dir = pai;
    }
  } catch {}
  return null;
}

if (!temWsFlag) {
  const wsId = resolverWorkspace();
  if (wsId) {
    extraArgs = ["--workspace", wsId];
  }
}

const child = spawn(process.execPath, [opencorpBin, ...extraArgs, ...args], {
  stdio: "inherit",
  env: process.env,
});

child.on("exit", (code) => {
  process.exit(code ?? 0);
});
