#!/usr/bin/env node
/**
 * oc — CLI de alta velocidade do OpenCorp
 * Wrapper ergonômico com detecção automática do workspace pelo diretório atual (cwd)
 */
import { spawn } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { existsSync, readFileSync } from "node:fs";

const aqui = dirname(fileURLToPath(import.meta.url));
const opencorpBin = join(aqui, "opencorp.mjs");

const args = process.argv.slice(2);

// Atalho rápido: oc doc ajuda [slug]
if (args[0] === "doc" && args[1] === "ajuda") {
  const slug = args[2] || "estudo-padronizacao";
  try {
    const res = await fetch(`http://127.0.0.1:4100/docs/${slug}`);
    if (res.ok) {
      const data = await res.json();
      console.log(`\n=== ${data.titulo} (${data.categoria}) ===\n`);
      console.log(data.conteudo);
      process.exit(0);
    }
  } catch {
    console.error(`erro: não foi possível conectar na API do OpenCorp em http://127.0.0.1:4100/docs/${slug}`);
  }
}

// Se não foi passada a flag --workspace, tenta inferir com máxima precisão
const temWsFlag = args.includes("--workspace") || args.includes("-w");
let extraArgs = [];

function resolverWorkspace() {
  // 1. Variável de ambiente explícita injetada pelo OpenCorp no runner
  if (process.env.OPENCORP_WORKSPACE && process.env.OPENCORP_WORKSPACE.trim()) {
    return process.env.OPENCORP_WORKSPACE.trim();
  }

  const homeGlobal = process.env.OPENCORP_HOME || join(process.env.HOME || "", ".opencorp");
  const wsJson = join(homeGlobal, "workspaces.json");
  let workspacesValidos = new Set();
  let ativoGlobal = null;

  if (existsSync(wsJson)) {
    try {
      const dados = JSON.parse(readFileSync(wsJson, "utf8"));
      if (Array.isArray(dados.workspaces)) {
        workspacesValidos = new Set(dados.workspaces.map((w) => w.id));
      }
      if (dados.ativo && typeof dados.ativo === "string") {
        ativoGlobal = dados.ativo;
      }
    } catch {}
  }

  // 2. Busca recursiva ascendente a partir do diretório atual procurando workspace
  try {
    let dir = process.cwd();
    while (dir && dir !== "/") {
      const pontoOpencorp = join(dir, ".opencorp");
      // Ignora ~/.opencorp global (onde moram workspaces, secrets, logs gerais)
      if (existsSync(pontoOpencorp) && pontoOpencorp !== homeGlobal && dir !== process.env.HOME) {
        const candidatoId = dir.split("/").pop();
        if (candidatoId && candidatoId !== ".opencorp" && workspacesValidos.has(candidatoId)) {
          return candidatoId;
        }
      }
      const pai = dirname(dir);
      if (pai === dir) break;
      dir = pai;
    }
  } catch {}

  // 3. Fallback: workspace globalmente ativo em ~/.opencorp/workspaces.json
  if (ativoGlobal) {
    return ativoGlobal;
  }

  return null;
}

if (!temWsFlag) {
  const wsId = resolverWorkspace();
  if (wsId) {
    extraArgs = ["--workspace", wsId];
  }
}

const child = spawn(process.execPath, [opencorpBin, ...extraArgs, ...args], {
  stdio: "inherit",
  env: process.env,
});

child.on("exit", (code) => {
  process.exit(code ?? 0);
});
